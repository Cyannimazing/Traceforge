# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Optional: without it, public market/contract snapshots remain available and
# wallet-history coverage is honestly reported as unavailable.
BITQUERY_ACCESS_TOKEN=

# Optional dedicated Solana RPC. Canonical public finalized reads are used when empty.
# If largest-account indexing fails, bounded GoPlus candidates are independently
# verified through the configured RPC. Candidate ranking remains unverified.
# Keep private URLs server-side; never use NEXT_PUBLIC_ for credentials.
SOLANA_RPC_URL=

# Optional historical-log-capable RPC for supported pool first-minute verification.
# Required methods: eth_chainId, eth_blockNumber, historical eth_getLogs,
# eth_getTransactionReceipt and eth_getBlockByNumber.
# Historical eth_getCode is not used. Decimals eth_call is optional: failure keeps
# exact raw amounts and timing proof but withholds normalized amount totals.
# Official factory events and receipts establish pool creation. Missing explorer
# routes do not force a historical-state read. Public providers may still deny logs.
# Without these, public RPC is attempted within a bounded read budget.
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# Optional durable SQLite path for resumable historical scans. Default is local
# .data/history.sqlite. Keep this file and its WAL private; do not replace on deploy.
# Node 24 required. Single persistent Node server; not an ephemeral edge filesystem.
TRACEFORGE_HISTORY_DB=
TRACEFORGE_REGISTRY_DB=

# Optional public SQD factory-history source for local development/evaluation.
# Disabled by default. Public service has shared rate limits and no SLA; its
# published terms exclude commercial use. No purchase or paid plan is enabled.
# https://docs.sqd.dev/en/portal/pricing
SQD_EVALUATION_ENABLED=0

# Gemini is DISABLED in src/lib/features.ts and its API. Setting a key does not enable it.
# Reviews cached public evidence after scanning; never executes trades.
# Default model: gemini-3.5-flash-lite. No paid fallback or automatic retries.
GEMINI_API_KEY=
